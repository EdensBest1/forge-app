{
  "name": "forge-mvp",
  "version": "0.72.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4174",
    "check:syntax": "node --check app.js",
    "check:smoke": "node smoke-test.mjs",
    "check:security": "node security-check.mjs",
    "check:release": "node release-check.mjs",
    "check:monetization": "node scripts/check-monetization-engine.mjs",
    "check:product-paths": "node scripts/check-product-paths-regression.mjs",
    "check:fencing": "node scripts/check-fencing-iron-gates-coverage.mjs",
    "check:nexus": "node nexus/smoke-test.mjs && node nexus/integration-test.mjs && node nexus/forge-enterprise-test.mjs",
    "nexus:status": "node nexus/orchestrator.mjs",
    "nexus:registry": "node nexus/orchestrator.mjs --registry",
    "nexus:tick": "node nexus/orchestrator.mjs --tick",
    "nexus:security": "node nexus/security-watch.mjs",
    "nexus:revenue": "node nexus/revenue-autopilot.mjs",
    "nexus:forge-enterprise": "node nexus/forge-enterprise-launch.mjs",
    "nexus:forge-enterprise:outreach": "node nexus/forge-enterprise-outreach.mjs",
    "nexus:forge-enterprise:seed": "node scripts/seed-forge-enterprise-accounts.mjs",
    "nexus:forge-enterprise:test": "node nexus/forge-enterprise-test.mjs",
    "nexus:test": "node nexus/smoke-test.mjs && node nexus/integration-test.mjs && node nexus/forge-enterprise-test.mjs",
    "demo:monetization:40000": "node scripts/generate-monetization-demo-records.mjs --count=40000",
    "check": "npm run check:syntax && npm run check:smoke && npm run check:security && npm run check:release && npm run check:monetization && npm run check:product-paths && npm run check:fencing && npm run check:nexus"
  }
}
